      "id": "TSA-B",
      "sd_section": "III.B",
      "title": "IT/OT network segmentation",
      "outcome_text": "Implement network segmentation policies and controls designed to prevent operational disruption if either the IT or OT system is compromised: document IT/OT interdependencies and external OT connections, define zone boundaries, prevent unauthorized communications between zones, and prohibit OT services from traversing the IT system unless encrypted in transit.",
      "sd_citation": "SD Pipeline-2021-02C III.B.1-2",
      "notes": "The IT/OT isolation outcome referenced in the project description; see report/figures/itot_boundary_architecture.svg.",
      "mapped_controls": [
        {
          "framework": "NIST_SP_800-82r3",
          "control_id": "Sec. 6.2 Network Architecture / Segmentation",
          "control_title": "OT network architecture, segmentation and segregation, DMZ design patterns",
          "mapping_strength": "Primary",
          "notes": "This is a named subsection of 800-82r3 Ch.6 and the closest direct analog to SD III.B."
        },
        {
          "framework": "NIST_SP_800-53r5",
          "control_id": "SC-7",
