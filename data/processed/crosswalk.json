    {
      "id": "TSA-E",
      "sd_section": "III.E",
      "title": "Patch and vulnerability management",
      "outcome_text": "Keep critical security patches and updates current on Critical Cyber Systems under a documented risk methodology that prioritizes CISA Known Exploited Vulnerabilities; where patching would severely degrade OT operational capability, document a timeline for compensating mitigations instead.",
      "sd_citation": "SD Pipeline-2021-02C III.E.1-3",
      "notes": "The OT patch-exception clause (III.E.3) is the single most OT-specific measure in the directive; a naive IT patch-SLA control does not satisfy it.",
      "mapped_controls": [
        {
          "framework": "NIST_SP_800-82r3",
          "control_id": "Sec. 6.2 Patch Management for OT",
          "control_title": "OT patch management guidance, incl. test-before-deploy and compensating controls where patching is infeasible",
