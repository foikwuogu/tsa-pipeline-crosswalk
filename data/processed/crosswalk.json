      "id": "TSA-A",
      "sd_section": "III.A",
      "title": "Critical Cyber System identification",
      "outcome_text": "Identify the Owner/Operator's Critical Cyber Systems: any Information or Operational Technology system or data that, if compromised or exploited, could result in operational disruption. Reassess this designation following operational changes and notify TSA within 60 days (added by 02D).",
      "sd_citation": "SD Pipeline-2021-02C III.A; VII.B (definition); 02D reassessment amendment",
      "notes": "Foundation for all downstream requirements; scope of 'Critical Cyber System' drives which assets the rest of the outcomes apply to.",
      "mapped_controls": [
        {
          "framework": "NIST_SP_800-82r3",
          "control_id": "Sec. 6.2 / Table 6-1",
          "control_title": "OT asset inventory and system categorization guidance",
          "mapping_strength": "Primary",
          "notes": "800-82r3 Ch.6 walks through OT asset inventory as the entry point for the whole security control selection process."
        },
